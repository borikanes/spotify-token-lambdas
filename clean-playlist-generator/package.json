{
  "name": "clean-playlist-generator",
  "version": "1.0.0",
  "description": "Generates a clean (non-explicit) copy of a playlist for the requesting user",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "build": "zip -r cleanPlaylistGenerator.zip index.js",
    "deploy": "aws lambda update-function-code --function-name cleanPlaylistGenerator --zip-file fileb://cleanPlaylistGenerator.zip"
  },
  "author": "Bori Oludemi",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  }
}
